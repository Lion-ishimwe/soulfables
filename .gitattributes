# Line endings.
#
# This repository is edited on Windows and deployed to Linux. Git's
# autocrlf converts files to CRLF on checkout, which is right for source
# a Windows editor opens and fatal for anything Linux executes: bash
# reads the carriage return as part of the command and reports
# "$'\r': command not found", naming a line that looks perfectly fine.
#
# It cost a deploy. So the files that run on the server are pinned to LF
# regardless of the platform they are checked out on.

* text=auto

*.sh            text eol=lf
*.service       text eol=lf
*.conf          text eol=lf
*.mjs           text eol=lf
*.sql           text eol=lf
deploy/*        text eol=lf
