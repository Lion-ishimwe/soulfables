{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadSoulfablesSettings",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParametersByPath",
        "ssm:GetParameters",
        "ssm:GetParameter"
      ],
      "Resource": "arn:aws:ssm:eu-north-1:*:parameter/soulfables/production/*"
    },
    {
      "Sid": "DecryptThoseSettings",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "ssm.eu-north-1.amazonaws.com"
        }
      }
    }
  ]
}
