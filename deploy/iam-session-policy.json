{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OpenASessionOnTheSoulfablesInstance",
      "Effect": "Allow",
      "Action": "ssm:StartSession",
      "Resource": [
        "arn:aws:ec2:eu-north-1:*:instance/i-02fff24055818aa9b",
        "arn:aws:ssm:eu-north-1::document/AWS-StartSSHSession",
        "arn:aws:ssm:eu-north-1::document/AWS-StartPortForwardingSession",
        "arn:aws:ssm:eu-north-1:*:document/SSM-SessionManagerRunShell"
      ]
    },
    {
      "Sid": "ManageOnlyYourOwnSessions",
      "Effect": "Allow",
      "Action": [
        "ssm:TerminateSession",
        "ssm:ResumeSession"
      ],
      "Resource": "arn:aws:ssm:*:*:session/${aws:username}-*"
    },
    {
      "Sid": "SeeWhatIsThere",
      "Effect": "Allow",
      "Action": [
        "ssm:DescribeSessions",
        "ssm:GetConnectionStatus",
        "ssm:DescribeInstanceInformation",
        "ssm:DescribeInstanceProperties",
        "ec2:DescribeInstances"
      ],
      "Resource": "*"
    }
  ]
}
