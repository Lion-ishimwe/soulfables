# =====================================================================
# Soulfables — environment
#
# Copy to .env.local and fill in. Never commit the filled copy.
#
# The app degrades honestly without these: public pages render from the
# fallback content in lib/content.ts so design work can continue, and the
# admin surface says plainly that it has no database rather than showing
# an empty table that looks like real data.
# =====================================================================

# --- Supabase --------------------------------------------------------
# Project settings → API. The anon key is public by design; every query
# it makes is still subject to Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# BYPASSES RLS ENTIRELY. Server-side only — no NEXT_PUBLIC_ prefix, so
# Next refuses to inline it into a client bundle. Used for exactly four
# jobs; see lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ------------------------------------------------------------
# Absolute origin. Used for canonical URLs, Open Graph, sitemap, and the
# redirect target on every emailed auth link.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Payments (D1 — unresolved) --------------------------------------
# Stripe does not support Rwanda-registered businesses. The provider is
# an open decision in documentation/architecture.html. Whichever is
# chosen, these two shapes are what the adapter needs.
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# --- Email (Phase 2) -------------------------------------------------
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM="Soulfables <hello@soulfables.co>"

# --- AI companion (Phase 6) ------------------------------------------
# Provider-agnostic by design; the adapter reads whichever is set.
AI_PROVIDER=
AI_API_KEY=
